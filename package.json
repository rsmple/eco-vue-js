{
  "name": "eco-vue-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/rsmple/eco-vue-js.git"
  },
  "version": "0.23.1",
  "homepage": "https://rsmple.github.io/eco-vue-js/",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "dev": "vite build --mode development --watch",
    "build-only": "vite build",
    "build-pack": "vite build && cd package && npm pack",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --concurrency auto",
    "lint:fix": "eslint . --concurrency auto --fix",
    "lint:inspect": "npx eslint --inspect-config",
    "docs:generate": "node build/docs-generate.ts",
    "docs:dev": "npm run docs:generate && node build/docs-releases.ts && vitepress dev docs",
    "docs:build": "node build/docs-generate.ts --check && node build/docs-releases.ts && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-svgo": "0.14.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-template-security": "0.2.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.11.1"
  },
  "peerDependencies": {
    "@tanstack/vue-query": ">=5.92.9",
    "vue": ">=3.5.30"
  },
  "peerDependenciesOptional": {
    "vue-router": ">=5.0.3"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node22": "22.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/postcss-import": "14.0.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "jsdom": "30.1.1",
    "npm-run-all2": "9.0.3",
    "path": "0.12.7",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "postcss-import": "17.0.0",
    "rollup-plugin-watch": "1.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-dts": "5.1.2",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-llms": "1.14.0",
    "vue-component-meta": "3.3.11",
    "vue-router": "5.3.1",
    "vue-tsc": "3.3.11"
  },
  "type": "module",
  "files": [
    "eslint",
    "dist",
    "docs",
    "scripts",
    "tailwind-base",
    "LICENSE"
  ],
  "bin": {
    "eco-vue-color-roles": "scripts/color-roles-codemod.js"
  },
  "license": "MIT",
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts"
}
