{
  "name": "eco-vue-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/rsmple/eco-vue-js.git"
  },
  "version": "0.15.3",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "dev": "vite build --mode development --watch",
    "build-only": "vite build",
    "build-pack": "vite build && cd package && npm pack",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --concurrency auto",
    "lint:fix": "eslint . --concurrency auto --fix",
    "lint:inspect": "npx eslint --inspect-config"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsonc": "3.4.1",
    "eslint-plugin-svgo": "0.13.0",
    "eslint-plugin-tailwindcss": "4.3.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.10.0"
  },
  "peerDependencies": {
    "@tanstack/vue-query": ">=5.92.9",
    "vue": ">=3.5.30"
  },
  "peerDependenciesOptional": {
    "vue-router": ">=5.0.3"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node22": "22.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "@types/postcss-import": "14.0.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "npm-run-all2": "9.0.3",
    "path": "0.12.7",
    "postcss": "8.5.26",
    "postcss-import": "17.0.0",
    "rollup-plugin-watch": "1.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3",
    "vue-router": ">=5.2.0",
    "vue-tsc": "3.3.10"
  },
  "type": "module",
  "files": [
    "eslint",
    "dist",
    "tailwind-base",
    "LICENSE"
  ],
  "license": "MIT",
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts"
}
