{
  "extends": "./tsconfig.vue.json",
  "include": [
    "env.d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "docs/**/*.ts",
    "docs/**/*.vue",
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "package/dist/**/*",
    "docs/.vitepress/config.ts",
    "docs/.vitepress/cache/**/*",
    "docs/.vitepress/dist/**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.docs.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "eco-vue-js/dist/*": [
        "./src/*"
      ]
    }
  }
}
